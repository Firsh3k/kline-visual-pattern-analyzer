# 复制为 deploy/.env 后填写（不要提交到 Git）
DEPLOY_ENV=staging
RELEASE_VERSION=v6.0.0-rc.1
RELEASE_COMMIT=          # git rev-parse HEAD（40 位）
RELEASED_AT=             # YYYY-MM-DD
BUILD_TIME=              # date -u +%Y-%m-%dT%H:%M:%SZ
ANALYSIS_API_TOKEN=      # openssl rand -hex 32
SESSION_SECRET=          # openssl rand -hex 32
LOGIN_USERNAME=owner
# 用 `printf '%s' '你的密码' | node apps/bff/src/hash-password.js` 生成；含 $，必须用单引号包起来
LOGIN_PASSWORD_HASH='scrypt$...'
MARKET_DATA_PROVIDER=live
BFF_PORT=8080
